---
import Layout from '@/layouts/Layout.astro';
import Section from '@/components/Section.astro';
import { defaultLang, useTranslations } from '@/i18n/ui';

// GitHub Pages serves a single 404.html for every path, so it uses the default language.
const lang = defaultLang;
const t = useTranslations(lang);
---

<Layout title={`${t('notFound.title')} | Wilder Lizama`} lang={lang}>
	<Section id="not-found">
		<div class="not-found">
			<h1>404</h1>
			<h2>{t('notFound.title')}</h2>
			<p>{t('notFound.body')}</p>
			<a href="/">{t('notFound.back')}</a>
		</div>
	</Section>
</Layout>

<style>
	.not-found {
		text-align: center;
		margin-top: 6em;
	}

	.not-found h1 {
		color: var(--color-accent);
	}

	p {
		margin: 1em 0;
	}
</style>
