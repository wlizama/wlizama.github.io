---
import Layout from '@/layouts/Layout.astro';
import Container from '@/components/Container.astro';
import { defaultLang, useTranslations } from '@/i18n/ui';

// GitHub Pages serves a single 404.html for every path, so it uses the default language.
const lang = defaultLang;
const t = useTranslations(lang);
---

<Layout title={`${t('notFound.title')} | Wilder Lizama`} lang={lang}>
	<Container as="section" class="not-found" aria-labelledby="not-found-title">
		<h1 class="mono">404<span aria-hidden="true">_</span></h1>
		<h2 id="not-found-title">{t('notFound.title')}</h2>
		<p>{t('notFound.body')}</p>
		<!-- `/` picks /en/ or /es/ from the visitor's language -->
		<a class="btn btn-primary" href="/">{t('notFound.back')}</a>
	</Container>
</Layout>

<style>
	.not-found {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-4);
		padding-block: 104px var(--space-24);
	}

	h1 {
		line-height: 1.1;
		letter-spacing: -0.03em;

		span {
			color: var(--color-accent);
		}
	}

	h2 {
		font-size: var(--text-xl);
	}

	p {
		max-width: 600px;
	}

	.btn {
		margin-top: var(--space-4);
	}
</style>
