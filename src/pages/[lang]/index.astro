---
import type { GetStaticPaths } from 'astro';
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/sections/hero.astro';
import Experience from '@/components/sections/experience.astro';
import Projects from '@/components/sections/projects.astro';
import Stack from '@/components/sections/stack.astro';
import Contact from '@/components/sections/contact.astro';
import { languages, useTranslations, type Lang } from '@/i18n/ui';

export const getStaticPaths = (() =>
	(Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<Layout title={t('meta.title')} lang={lang}>
	<Hero lang={lang} />
	<Experience lang={lang} />
	<Projects lang={lang} />
	<Stack lang={lang} />
	<Contact lang={lang} />
</Layout>
