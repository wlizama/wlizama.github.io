---
import Container from './Container.astro';

const { id } = Astro.props
---
<Container as="section" id={id} class="section">
    <slot />
</Container>
<style>
  .section {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 1em;
    margin-top: 2em;
  }
</style>
