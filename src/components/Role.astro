---
import { formatMonthYear, type CV, type Lang } from "@/i18n/ui";

interface Props {
  job: CV["work"][number];
  lang: Lang;
  /** Highlights the dates in the accent color (the ongoing role). */
  current?: boolean;
}

const { job, lang, current = false } = Astro.props;
---

<p class:list={["dates mono", { current }]}>{formatMonthYear(job.startDate, lang)} — {formatMonthYear(job.endDate, lang)}</p>
<h3>{job.position} · {job.name}</h3>
<p class="summary">{job.summary}</p>
<p class="skills mono">{job.skills.join(" · ")}</p>

<style>
  .dates {
    font-size: var(--text-sm);
    color: var(--color-muted);

    &.current {
      color: var(--color-accent);
    }
  }

  h3 {
    margin-top: 6px;
  }

  .summary {
    margin-top: 10px;
    max-width: 760px;
  }

  .skills {
    margin-top: 10px;
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
</style>
