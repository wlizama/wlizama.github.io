---
import type { HTMLTag } from 'astro/types';

interface Props {
  as?: HTMLTag;
  class?: string;
  [key: string]: any;
}

const { as: Tag = 'div', class: className, ...rest } = Astro.props;
---

<Tag class:list={['container', className]} {...rest}>
  <slot />
</Tag>

<style>
  .container {
    width: 100%;
    max-width: var(--container-width);
    margin-inline: auto;
    padding-inline: var(--container-gutter);
  }
</style>
