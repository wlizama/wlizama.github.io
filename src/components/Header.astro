---
import Container from "@/components/Container.astro";
import { getCV, languages, sectionIds, useTranslations, type Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const ids = sectionIds[lang];
const { basics } = getCV(lang);

// Absolute links so the nav also works from pages without these sections (404);
// on the home page they stay same-document jumps.
const home = `/${lang}/`;
const menuItems = [
  { name: t("nav.experience"), link: `${home}#${ids.experience}` },
  { name: t("nav.projects"), link: `${home}#${ids.projects}` },
  { name: t("nav.stack"), link: `${home}#${ids.stack}` },
  { name: t("nav.contact"), link: `${home}#${ids.contact}` },
];

const languageLinks = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  name: languages[code],
  href: `/${code}/`,
}));
---

<header>
  <Container as="nav" class="header-inner mono" aria-label={t("nav.label")}>
    <a href={home} class="logo"><span aria-hidden="true">~/</span>{basics.profiles.find((p) => p.network === "GitHub")?.username}</a>
    <!-- Below 860px the menu collapses behind this button; it stays hidden without JS. -->
    <button
      type="button"
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label={t("nav.open")}
      data-label-open={t("nav.open")}
      data-label-close={t("nav.close")}
      hidden
    >
      <svg class="icon-open" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg class="icon-close" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
    <div class="panel" id="nav-menu">
      <ul class="menu">
        {menuItems.map((item) => (
          <li>
            <a href={item.link}>{item.name}</a>
          </li>
        ))}
      </ul>
      <a class="btn-cv panel-cv" href={basics.cv_url} target="_blank" rel="noopener noreferrer">{t("cta.cv")}</a>
    </div>
    <div class="actions">
      <ul class="lang-switch" aria-label={t("lang.label")}>
        {languageLinks.map(({ code, name, href }) => (
          <li>
            <a
              href={href}
              hreflang={code}
              lang={code}
              aria-current={code === lang ? "page" : undefined}
              title={name}
            >
              {code.toUpperCase()}
            </a>
          </li>
        ))}
      </ul>
      <a class="btn-cv actions-cv" href={basics.cv_url} target="_blank" rel="noopener noreferrer">{t("cta.cv")}</a>
    </div>
  </Container>
</header>

<script>
  const header = document.querySelector("header");

  if (header) {
    const setHeaderHeight = () => {
      document.documentElement.style.setProperty(
        "--header-height",
        `${header.offsetHeight}px`
      );
    };

    setHeaderHeight();
    new ResizeObserver(setHeaderHeight).observe(header);

    // The header's CV button only shows once the hero's own one is off screen,
    // so it never appears twice at once. Pages without a hero (404) keep it.
    const heroCV = document.querySelector("[data-hero-cv]");
    if (heroCV) {
      new IntersectionObserver(([entry]) => {
        header.toggleAttribute("data-hero-cv-visible", entry.isIntersecting);
      }, { rootMargin: `-${header.offsetHeight}px 0px 0px 0px` }).observe(heroCV);
    }

    const toggle = header.querySelector<HTMLButtonElement>(".menu-toggle");
    const panel = header.querySelector<HTMLElement>("#nav-menu");

    if (toggle && panel) {
      const setOpen = (open: boolean) => {
        header.toggleAttribute("data-open", open);
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute("aria-label", (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? "");
      };

      // Collapsing only kicks in once the toggle can work.
      header.classList.add("has-menu");
      toggle.hidden = false;
      toggle.addEventListener("click", () => setOpen(!header.hasAttribute("data-open")));
      panel.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setOpen(false)));
    }
  }
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(var(--color-bg-rgb), 0.88);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  /* Desktop: the links sit in a truly centered column, so they don't move
     when the CV button appears or hides on the right. */
  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    padding-block: 14px;
  }

  .logo {
    justify-self: start;
  }

  .logo {
    font-weight: 700;
    color: var(--color-heading);

    span {
      color: var(--color-accent);
    }

    &:hover,
    &:focus-visible {
      color: var(--color-heading);
    }
  }

  .menu {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-6);
    font-size: var(--text-sm);

    a {
      display: inline-block;
      padding-block: 10px;
      color: var(--color-text);

      &:hover,
      &:focus-visible {
        color: var(--color-accent);
      }
    }
  }

  .actions {
    justify-self: end;
    display: flex;
    align-items: center;
  }

  .lang-switch {
    display: flex;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    font-size: var(--text-xs);

    a {
      display: block;
      padding: 10px 12px;
      color: var(--color-text);

      &:hover,
      &:focus-visible {
        color: var(--color-accent);
      }

      &[aria-current="page"] {
        background: var(--color-border-subtle);
        color: var(--color-heading);
      }
    }
  }

  .btn-cv {
    display: inline-flex;
    align-items: center;
    padding: 10px 16px;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-bg);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 700;
    transition: background-color 0.2s ease, transform 0.2s ease;

    &:hover,
    &:focus-visible {
      background: var(--color-accent-hover);
      color: var(--color-bg);
      transform: translateY(-1px);
    }
  }

  /* While the hero's CV button is on screen this one takes no space, so the
     language switch lines up with the page edge; it then slides in. */
  .actions-cv {
    max-width: 12rem;
    margin-left: var(--space-3);
    overflow: hidden;
    white-space: nowrap;
    transition: max-width 0.25s ease, margin 0.25s ease, padding 0.25s ease, opacity 0.2s ease, visibility 0.25s ease, background-color 0.2s ease, transform 0.2s ease;
  }

  [data-hero-cv-visible] .actions-cv {
    max-width: 0;
    margin-left: 0;
    padding-inline: 0;
    opacity: 0;
    visibility: hidden;
  }

  .panel-cv,
  .menu-toggle {
    display: none;
  }

  .icon-open,
  .icon-close {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  /* Mobile and portrait tablets: one row (logo, languages, toggle) with the
     links and the CV button in a dropdown panel. */
  @media (width < 860px) {
    .header-inner {
      display: flex;
      flex-wrap: nowrap;
      gap: var(--space-3);
    }

    .logo {
      margin-right: auto;
    }

    .actions {
      order: 1;
      gap: var(--space-3);
    }

    .actions-cv {
      display: none;
    }

    .panel {
      order: 3;
    }

    .panel-cv {
      display: inline-flex;
      justify-content: center;
      margin-top: var(--space-3);
      padding-block: 12px;
    }

    .menu {
      flex-direction: column;
      gap: 0;
      font-size: var(--text-base);

      a {
        display: block;
        padding-block: 12px;
      }
    }

    .has-menu {
      .menu-toggle {
        order: 2;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        background: transparent;
        color: var(--color-heading);
        cursor: pointer;

        &:hover,
        &:focus-visible {
          border-color: var(--color-accent);
          color: var(--color-accent);
        }
      }

      .icon-close,
      &[data-open] .icon-open {
        display: none;
      }

      &[data-open] .icon-close {
        display: block;
      }

      .panel {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        flex-direction: column;
        padding: var(--space-2) var(--container-gutter) var(--space-6);
        background: var(--color-bg);
        border-bottom: 1px solid var(--color-border-subtle);
      }

      &[data-open] .panel {
        display: flex;
      }
    }

    /* Without JS the panel stays in the flow, below the first row. */
    header:not(.has-menu) {
      .header-inner {
        flex-wrap: wrap;
      }

      .panel {
        display: flex;
        flex-direction: column;
        width: 100%;
      }
    }
  }
</style>
