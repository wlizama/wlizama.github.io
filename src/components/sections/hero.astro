---
import Container from "../Container.astro";
import { getCV, sectionIds, useTranslations, type Lang } from "@/i18n/ui";

interface Props {
  lang: Lang
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { basics, languages } = getCV(lang);
const { profile, location } = basics;
const ids = sectionIds[lang];

// perfil.json card: [key, value] pairs rendered as syntax-highlighted JSON.
const profileEntries: [string, string | string[]][] = [
  [t("profile.role"), profile.role],
  [t("profile.experience"), profile.experience],
  [t("profile.remote"), profile.remote],
  [t("profile.stack"), profile.stack],
  [t("profile.location"), `${location.city}, ${location.region} · ${location.timezone}`],
  [t("profile.languages"), languages.map(({ language }) => language)],
];
---

<Container as="section" id={ids.top} class="hero" aria-labelledby="hero-title">
  <div class="intro">
    <p class="prompt mono"><span aria-hidden="true">$</span> {t("hero.command")}</p>
    <h1 id="hero-title" class="mono">{basics.displayName}<span class="cursor" aria-hidden="true">_</span></h1>
    <p class="headline">{basics.headline}</p>
    <p class="tagline">{basics.tagline}</p>
    <div class="ctas">
      <a class="btn btn-primary" href={basics.cv_url} target="_blank" rel="noopener noreferrer">{t("cta.cv")}</a>
      <a class="btn btn-ghost" href={`#${ids.contact}`}>{t("cta.contact")}</a>
    </div>
  </div>

  <figure class="profile mono">
    <figcaption>
      <span class="dots" aria-hidden="true"><span></span><span></span><span></span></span>
      {t("profile.file")}
    </figcaption>
    <pre><span class="line">&#123;</span>{profileEntries.map(([key, value], i) => (
      <span class="line indent"><span class="key">"{key}"</span>: {Array.isArray(value)
        ? <>[{value.map((item, j) => <><span class="str">"{item}"</span>{j < value.length - 1 && ", "}</>)}]</>
        : <span class="str">"{value}"</span>}{i < profileEntries.length - 1 && ","}</span>
    ))}<span class="line">&#125;</span></pre>
  </figure>
</Container>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-14);
    padding-block: 104px var(--space-24);
  }

  .intro {
    flex: 999 1 520px;
    min-width: 0;
  }

  .prompt {
    margin-bottom: var(--space-4);
    font-size: 15px;
    color: var(--color-muted);

    span {
      color: var(--color-accent);
    }
  }

  h1 {
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .cursor {
    color: var(--color-accent);
  }

  .headline {
    margin-top: 20px;
    font-size: var(--text-xl);
    line-height: 1.45;
    font-weight: 500;
    color: var(--color-heading);
  }

  .tagline {
    margin-top: var(--space-4);
    max-width: 600px;
    font-size: var(--text-md);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
    margin-top: 36px;
  }

  .profile {
    flex: 1 1 380px;
    min-width: 0;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: var(--color-surface);
    overflow: hidden;
    font-size: var(--text-sm);
    line-height: 1.8;
  }

  figcaption {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .dots {
    display: inline-flex;
    gap: var(--space-2);
    margin-right: var(--space-2);

    span {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--color-border);
    }
  }

  pre {
    padding: 20px 22px;
    white-space: pre-wrap;
    font-family: inherit;
    color: var(--color-text);
  }

  .line {
    display: block;
  }

  .indent {
    padding-left: 2ch;
  }

  .key {
    color: var(--color-accent);
  }

  .str {
    color: var(--color-accent-2);
  }
</style>
