---
import Section from "../Section.astro";
import { getCV, sectionIds, useTranslations, type Lang } from "@/i18n/ui";

interface Props {
  lang: Lang
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { skills } = getCV(lang);
---
<Section id={sectionIds[lang].stack} title={t("section.stack")}>
  <div class="groups">
    {skills.map(({ category, items }) => (
      <div class="group">
        <h3 class="mono">{category.toLocaleLowerCase(lang)}</h3>
        <ul>
          {items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    ))}
  </div>
</Section>

<style>
  .groups {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .group {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3) var(--space-6);
  }

  h3 {
    flex: 0 0 200px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-muted);
  }

  ul {
    flex: 999 1 400px;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  li {
    padding: 6px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-heading);
  }
</style>
