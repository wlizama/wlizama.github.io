---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Section from "../Section.astro";
import TechList from "../TechList.astro";
import { getCV, sectionIds, useTranslations, type Lang } from "@/i18n/ui";

interface Props {
  lang: Lang
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = getCV(lang).projects.filter((project) => project.isActive);

// cv.json references images by file name; they live in src/assets/projects
// so astro:assets can resize them and emit width/height (no layout shift).
const images = import.meta.glob<{ default: ImageMetadata }>("/src/assets/projects/*", { eager: true });
const imageFor = (file: string) => {
  const image = images[`/src/assets/projects/${file}`];
  if (!image) throw new Error(`Project image not found: src/assets/projects/${file}`);
  return image.default;
};
---
<Section id={sectionIds[lang].projects} title={t("section.projects")}>
  <ul class="rows">
    {projects.map((project) => (
      <li class="row">
        <Image
          src={imageFor(project.image)}
          alt=""
          width={480}
          class="thumb"
          loading="lazy"
          decoding="async"
        />
        <div class="body">
          <h3>{project.name}</h3>
          <p>{project.description}</p>
          <TechList items={project.tags} class="tags" />
        </div>
        {project.github && (
          <a
            class="source mono"
            href={project.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t("projects.sourceLabel", { name: project.name })}
          >
            {t("projects.source")}
          </a>
        )}
      </li>
    ))}
  </ul>
</Section>

<style>
  .rows {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border-subtle);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6) var(--space-8);
    padding: 28px var(--space-4);
    border-bottom: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    transition: background-color 0.2s ease;

    &:hover {
      background: var(--color-surface);
    }
  }

  .thumb {
    flex: 0 0 240px;
    width: 240px;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid var(--color-border);
  }

  .body {
    flex: 999 1 380px;
    min-width: 0;

    p {
      margin-top: var(--space-2);
    }
  }

  .tags {
    margin-top: var(--space-2);
  }

  .source {
    flex: 0 0 auto;
    padding-block: 10px;
    font-size: var(--text-sm);
  }

  @media (width <= 480px) {
    .thumb {
      flex-basis: 100%;
      width: 100%;
    }
  }

  /* Phones: the source link sits right under the tags instead of a full
     row gap away. */
  @media (width < 640px) {
    .row {
      row-gap: var(--space-2);
    }

    .thumb {
      margin-bottom: var(--space-3);
    }
  }
</style>
