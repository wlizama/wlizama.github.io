---
import Section from "../Section.astro";
import Role from "../Role.astro";
import { getCV, sectionIds, useTranslations, type Lang } from "@/i18n/ui";

interface Props {
  lang: Lang
}

// Roles shown up front; the rest sit behind "See {n} earlier roles".
const VISIBLE_ROLES = 3;

const { lang } = Astro.props;
const t = useTranslations(lang);
const { work } = getCV(lang);

const recent = work.slice(0, VISIBLE_ROLES);
const earlier = work.slice(VISIBLE_ROLES);
const year = (date: string | null) => date?.slice(0, 4) ?? "";
---
<Section id={sectionIds[lang].experience} title={t("section.experience")}>
  <ol class="timeline">
    {recent.map((job) => {
      const current = !job.endDate;
      return (
        <li class:list={["role", { current }]}>
          <span class="marker" aria-hidden="true"></span>
          <Role job={job} lang={lang} current={current} />
        </li>
      );
    })}
    {earlier.length > 0 && (
      <li class="role">
        <span class="marker marker-more" aria-hidden="true"></span>
        <details class="earlier">
          <summary>
            {t("experience.older", {
              n: earlier.length,
              from: year(earlier[earlier.length - 1].startDate),
              to: year(earlier[0].endDate),
            })} <span aria-hidden="true">→</span>
          </summary>
          <ol class="timeline-earlier">
            {earlier.map((job) => (
              <li><Role job={job} lang={lang} /></li>
            ))}
          </ol>
        </details>
      </li>
    )}
  </ol>
</Section>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    padding-left: 28px;
    border-left: 2px solid var(--color-border-subtle);
  }

  .role {
    position: relative;
  }

  .marker {
    position: absolute;
    left: -37px;
    top: 6px;
    width: 14px;
    height: 14px;
    box-sizing: content-box;
    border-radius: 50%;
    background: var(--color-border);
    border: 3px solid var(--color-bg);
  }
  .current .marker {
    background: var(--color-accent);
  }
  .marker-more {
    left: -35px;
    top: 8px;
    width: 10px;
    height: 10px;
    border: none;
    background: var(--color-border-subtle);
  }

  .earlier > summary {
    cursor: pointer;
    width: fit-content;
    list-style: none;
    font-weight: 600;
    color: var(--color-accent);
    transition: color 0.2s ease;

    &::-webkit-details-marker {
      display: none;
    }

    &:hover {
      color: var(--color-heading);
    }

    span {
      display: inline-block;
      transition: transform 0.2s ease;
    }
  }

  .earlier[open] > summary span {
    transform: rotate(90deg);
  }

  .timeline-earlier {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    margin-top: var(--space-10);
  }
</style>
