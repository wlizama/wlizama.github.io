---
import Calendar from "@/icons/Calendar.astro";
import Section from "../Section.astro";
import SectionHead from "../SectionHead.astro";
import { formatMonthYear, getCV, sectionIds, useTranslations, type Lang } from "@/i18n/ui";

interface Props {
  lang: Lang
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { work } = getCV(lang);
---
<Section id={sectionIds[lang].experience}>
  <SectionHead icon={'experience'} title={t("section.experience")} />
  <p>{t("experience.intro")}</p>
  <ul class="timeline">
    {work.map((job) => (
      <li class="timeline-event">
        <label class="timeline-event-icon" />
        <div class="timeline-event-copy">
          <div class="timeline-event-thumbnail">
            <Calendar />
            <span>{formatMonthYear(job.startDate, lang)} — {formatMonthYear(job.endDate, lang)}</span>
          </div>
          <h3>{job.position} <span class="separator">{t("experience.at")}</span> {job.name}</h3>
          { job.highlights && (
            <ul class="task-list">
              {job.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
            <div>
              <h4>{t("experience.skills")}</h4>
              <p class="skills">{job.skills.join(", ")}</p>
            </div>
          )}
        </div>
      </li>
    ))}
  </ul>
</Section>

<style>
  .timeline {
    margin: 1em auto;
    position: relative;
  }
  .timeline:before {
    background-color: var(--color-muted);
    content: '';
    margin-left: -1px;
    position: absolute;
    top: 0;
    left: 1em;
    width: 2px;
    height: 100%;
  }

  .timeline-event {
    position: relative;
  }
  .timeline-event:hover .timeline-event-icon {
    transform: rotate(-45deg);
  }
  .timeline-event:hover .timeline-event-thumbnail {
    color: var(--color-accent-3);
  }

  .timeline-event-copy {
    padding: 2em 0;
    position: relative;
    top: -1.875em;
    left: 3em;
    width: 95%;

    .separator {
      color: var(--color-muted);
    }
  }

  .timeline-event-icon {
    transition: transform 0.2s ease-in;
    transform: rotate(45deg);
    background-color: var(--color-accent-3);
    display: block;
    margin: 0.5em 0.5em 0.5em -0.5em;
    position: absolute;
    top: 0;
    left: 1em;
    width: 1em;
    height: 1em;
    outline: 2px solid var(--color-bg);
  }

  .timeline-event-thumbnail {
    transition: color 0.2s ease;
    color: var(--color-muted);
    font-weight: 700;
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.5em;
    align-items: center;
    margin-bottom: 0.5em;

    svg {
      height: 1.4em;
    }
    span {
      flex: 1;
    }
  }

  .task-list {
    list-style-type: square;
    padding-left: 1em;

    li {
      margin-bottom: 0.5em;
    }
  }
  .skills {
    color: var(--color-muted);
    font-style: italic;
    font-size: .9em;
  }

  @media (width <= 768px) {
    .timeline-event-copy {
      width: 88%;
    }
  }

</style>