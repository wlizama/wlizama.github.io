---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans/700.css';
import '@fontsource-variable/jetbrains-mono';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { getCV, languages, useTranslations, type Lang } from '@/i18n/ui';

export type Theme = 'terminal' | 'midnight' | 'monokai' | 'one-dark-pro' | 'material-dark' | 'dracula' | 'nord' | 'solarized';

// The whole site's color theme is driven by this single value — no UI needed.
// Change it (or pass a `theme` prop to <Layout>) to re-skin every page at once.
const DEFAULT_THEME: Theme = 'terminal';

interface Props {
	title: string;
	lang: Lang;
	description?: string;
	/** Path after the language prefix ('' for the home page); drives hreflang alternates. */
	path?: string;
	theme?: Theme;
}

const { title, lang, path = '', theme = DEFAULT_THEME } = Astro.props;
const t = useTranslations(lang);
const { basics } = getCV(lang);
const description = Astro.props.description ?? t('meta.description');

// Kept in sync with the --color-accent value of each theme below, since a
// <meta> tag can't read CSS custom properties.
const THEME_ACCENT: Record<Theme, string> = {
	terminal: '#ff6188',
	midnight: '#ff6188',
	monokai: '#ff6b9d',
	'one-dark-pro': '#61afef',
	'material-dark': '#c792ea',
	dracula: '#bd93f9',
	nord: '#88c0d0',
	solarized: '#b58900',
};

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const alternates = (Object.keys(languages) as Lang[]).map((code) => ({
	hreflang: code,
	href: new URL(`/${code}/${path}`, Astro.site).toString(),
}));
const imageURL = new URL('images/banner.webp', Astro.site);

const personLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: basics.name,
	jobTitle: basics.occupation,
	email: basics.email,
	url: Astro.site?.toString(),
	image: basics.image,
	sameAs: basics.profiles.map((profile) => profile.url),
	address: {
		'@type': 'PostalAddress',
		addressLocality: basics.location.city,
		addressCountry: basics.location.countryCode,
	},
};
---

<!doctype html>
<html lang={lang} data-theme={theme}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalURL} />
		{alternates.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}
		<link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="theme-color" content={THEME_ACCENT[theme]} />

		<meta name="author" content={basics.name} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageURL} />
		<meta property="og:locale" content={lang === 'es' ? 'es_PE' : 'en_US'} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageURL} />

		<script type="application/ld+json" set:html={JSON.stringify(personLd)} />
	</head>
	<body>
		<a href="#main" class="skip-link">{t('skip')}</a>
		<Header lang={lang} />
		<main id="main">
			<slot />
		</main>
		<Footer lang={lang} />
	</body>
</html>
<style is:global>
	:root {
		color-scheme: dark;

		--header-height: 80px;

		/* Theme-agnostic design tokens */
		--font-sans: 'IBM Plex Sans', system-ui, sans-serif;
		--font-mono: 'JetBrains Mono Variable', ui-monospace, monospace;

		--text-xs: 0.8125rem;   /* 13px — meta, stack lines */
		--text-sm: 0.875rem;    /* 14px — nav, dates, chips */
		--text-base: 1rem;      /* 16px — body */
		--text-md: 1.0625rem;   /* 17px — lead paragraphs */
		--text-lg: 1.3125rem;   /* 21px — item titles (h3) */
		--text-xl: 1.375rem;    /* 22px — hero headline */
		--text-2xl: 1.875rem;   /* 30px — section titles (h2) */
		--text-hero: clamp(2.25rem, 5.2vw, 3.75rem); /* 36–60px — h1 */

		--space-1: 0.25rem;  /* 4px */
		--space-2: 0.5rem;   /* 8px */
		--space-3: 0.75rem;  /* 12px */
		--space-4: 1rem;     /* 16px */
		--space-6: 1.5rem;   /* 24px */
		--space-8: 2rem;     /* 32px */
		--space-10: 2.5rem;  /* 40px */
		--space-12: 3rem;    /* 48px */
		--space-14: 3.5rem;  /* 56px */
		--space-18: 4.5rem;  /* 72px */
		--space-24: 6rem;    /* 96px */

		--radius-sm: 8px;    /* buttons, language switch */
		--radius-md: 12px;   /* rows, thumbnails */
		--radius-lg: 16px;   /* cards */
		--radius-pill: 999px;

		--container-width: 1120px;
		--container-gutter: var(--space-6);

		/*
		 * Each theme below defines the same 9 roles, editor-theme style:
		 *   bg / surface           — page background and card surfaces
		 *   heading / text / muted — text emphasis scale (grayscale-ish)
		 *   accent                 — primary: links, nav, logo, the CTA button
		 *   accent-2               — secondary: headings/titles (h2 everywhere)
		 *   accent-3               — tertiary: tags, timeline markers/dates
		 * Three genuinely different hues per theme is what makes it read as a
		 * real color scheme instead of "one color + gray".
		 * On top of those, accent-hover / border / border-subtle are set by
		 * `terminal` and shared by the legacy themes (see below).
		 */

		/* terminal (default) */
		--color-bg: #0d1117;
		--color-bg-rgb: 13, 17, 23;
		--color-surface: #161b22;
		--color-heading: #f0f6fc;
		--color-text: #c9d1d9;
		--color-muted: #8b949e;
		--color-accent: #ff6188;
		--color-accent-rgb: 255, 97, 136;
		--color-accent-hover: #ff8fab;
		--color-accent-2: #ffd866;
		--color-accent-3: #8b949e;
		--color-accent-3-rgb: 139, 148, 158;
		--color-accent-3-soft: rgba(var(--color-accent-3-rgb), 0.12);
		--color-accent-3-soft-border: rgba(var(--color-accent-3-rgb), 0.35);
		--color-border: #30363d;
		--color-border-subtle: #21262d;
	}

	/* The legacy editor themes share a neutral translucent border tint and
	   reuse the heading color as the hover state of accent-filled buttons. */
	:root:not([data-theme='terminal']) {
		--color-border: rgba(255, 255, 255, 0.12);
		--color-border-subtle: rgba(255, 255, 255, 0.08);
		--color-accent-hover: var(--color-heading);
	}

	:root[data-theme='midnight'] {
		--color-bg: #0f172a;
		--color-bg-rgb: 15, 23, 42;
		--color-surface: #141d33;
		--color-heading: #f8fafc;
		--color-text: #cbd5e1;
		--color-muted: #8b94a8;
		--color-accent: #ff6188;
		--color-accent-rgb: 255, 97, 136;
		--color-accent-2: #ffd866;
		--color-accent-3: #9cc4e4;
		--color-accent-3-rgb: 156, 196, 228;
		--color-accent-3-soft: rgba(var(--color-accent-3-rgb), 0.12);
		--color-accent-3-soft-border: rgba(var(--color-accent-3-rgb), 0.35);
	}

	:root[data-theme='monokai'] {
		--color-bg: #272822;
		--color-bg-rgb: 39, 40, 34;
		--color-surface: #34352d;
		--color-heading: #f8f8f2;
		--color-text: #cfcfc2;
		--color-muted: #948e7f;
		--color-accent: #ff6b9d;
		--color-accent-rgb: 255, 107, 157;
		--color-accent-2: #66d9ef;
		--color-accent-3: #e6db74;
		--color-accent-3-rgb: 230, 219, 116;
	}

	:root[data-theme='one-dark-pro'] {
		--color-bg: #282c34;
		--color-bg-rgb: 40, 44, 52;
		--color-surface: #2f333d;
		--color-heading: #d7dae0;
		--color-text: #abb2bf;
		--color-muted: #949cae;
		--color-accent: #61afef;
		--color-accent-rgb: 97, 175, 239;
		--color-accent-2: #c678dd;
		--color-accent-3: #98c379;
		--color-accent-3-rgb: 152, 195, 121;
	}

	:root[data-theme='material-dark'] {
		--color-bg: #263238;
		--color-bg-rgb: 38, 50, 56;
		--color-surface: #2e3c43;
		--color-heading: #eeffff;
		--color-text: #b0bec5;
		--color-muted: #8aa2ab;
		--color-accent: #c792ea;
		--color-accent-rgb: 199, 146, 234;
		--color-accent-2: #89ddff;
		--color-accent-3: #f78c6c;
		--color-accent-3-rgb: 247, 140, 108;
	}

	:root[data-theme='dracula'] {
		--color-bg: #282a36;
		--color-bg-rgb: 40, 42, 54;
		--color-surface: #343746;
		--color-heading: #f8f8f2;
		--color-text: #e2e2dc;
		--color-muted: #9aa1c4;
		--color-accent: #bd93f9;
		--color-accent-rgb: 189, 147, 249;
		--color-accent-2: #ff79c6;
		--color-accent-3: #50fa7b;
		--color-accent-3-rgb: 80, 250, 123;
	}

	:root[data-theme='nord'] {
		--color-bg: #2e3440;
		--color-bg-rgb: 46, 52, 64;
		--color-surface: #3b4252;
		--color-heading: #eceff4;
		--color-text: #d8dee9;
		--color-muted: #9aa5b1;
		--color-accent: #88c0d0;
		--color-accent-rgb: 136, 192, 208;
		--color-accent-2: #c5a5c0;
		--color-accent-3: #ebcb8b;
		--color-accent-3-rgb: 235, 203, 139;
	}

	:root[data-theme='solarized'] {
		--color-bg: #002b36;
		--color-bg-rgb: 0, 43, 54;
		--color-surface: #073642;
		--color-heading: #eee8d5;
		--color-text: #93a1a1;
		--color-muted: #7c9598;
		--color-accent: #b58900;
		--color-accent-rgb: 181, 137, 0;
		--color-accent-2: #54a8e3;
		--color-accent-3: #ea7ab4;
		--color-accent-3-rgb: 234, 122, 180;
	}

	*, *::before, *::after {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}
	body, html {
		font-family: var(--font-sans);
		font-size: 16px;
		line-height: 1.6;
	}
	html {
		scroll-behavior: smooth;
		scrollbar-gutter: stable;
		scroll-padding-top: var(--header-height);
	}

	body {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		background: var(--color-bg);
		color: var(--color-text);
	}

	main {
		flex: 1;
	}

	p {
    text-wrap: pretty;
    color: var(--color-text);
  }

	a {
		text-decoration: none;
		color: var(--color-accent);
		transition: color 0.2s ease;
	}
	a:hover,
	a:focus-visible {
		color: var(--color-heading);
	}

  ul, ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
	h1, h2, h3 {
		line-height: 1.25;
		color: var(--color-heading);
	}
	h1 {
		font-size: var(--text-hero);
	}
	h2 {
		font-size: var(--text-2xl);
	}
	h3 {
		font-size: var(--text-lg);
	}
	h4 {
		font-size: 1rem;
		color: var(--color-muted);
	}

	/* utility classes */
	.mr-1 {
		margin-right: 1rem;
	}
	.mono {
		font-family: var(--font-mono);
	}

	/* Buttons from direction B: filled accent and outlined ghost */
	.btn {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: 13px 21px;
		border: 1px solid transparent;
		border-radius: var(--radius-sm);
		font-family: var(--font-sans);
		font-weight: 600;
		transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
	}
	.btn-primary {
		background: var(--color-accent);
		color: var(--color-bg);
		font-weight: 700;
	}
	.btn-primary:hover,
	.btn-primary:focus-visible {
		background: var(--color-accent-hover);
		color: var(--color-bg);
		transform: translateY(-1px);
	}
	.btn-ghost {
		border-color: var(--color-border);
		color: var(--color-heading);
	}
	.btn-ghost:hover,
	.btn-ghost:focus-visible {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}

	.skip-link {
		position: absolute;
		top: -3em;
		left: 0;
		z-index: 2000;
		padding: 0.75em 1em;
		border-radius: 0 0 0.5em 0;
		background: var(--color-surface);
		color: var(--color-heading);
		text-decoration: none;
		transition: top 0.2s ease;
	}
	.skip-link:focus {
		top: 0;
	}

	:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
		border-radius: 6px;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
		*, *::before, *::after {
			transition: none !important;
			animation: none !important;
		}
	}
</style>
